# /etc/systemd/system/tokenzswap-cache.service
# Runs the cache server (code/cache-server) as the ubuntu user, restarts it on failure, starts it on boot.
[Unit]
Description=TokenZswap cache server
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
User=ubuntu
WorkingDirectory=/home/ubuntu/tokenzswap/cache-server
ExecStart=/usr/bin/npm start
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
